generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  image            String?
  role             String    @default("admin")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  slug             String?   @unique
  resetToken       String?   @unique
  resetTokenExpires DateTime?
  adminId          String?
  admin            User?     @relation("AdminCollabs", fields: [adminId], references: [id])
  collabs          User[]    @relation("AdminCollabs")
  createdEvents    Event[]   @relation("CreatedEvents")
  recordedExpenses Expense[]
  recordedRevenues AdditionalRevenue[]
  createdStudents  Student[] @relation("CreatedStudents")
  qrCodes          QrCode[]  @relation("AdminQrCodes")

  @@index([email])
  @@index([resetToken])
  @@index([adminId])
}

model Student {
  id                  String              @id @default(cuid())
  rollNo              String
  name                String
  email               String
  class               String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String?
  phone               String?
  payments            Payment[]
  printDistributions  PrintDistribution[]
  createdBy           User?               @relation("CreatedStudents", fields: [createdById], references: [id])
  participatingEvents Event[]             @relation("EventToStudent")

  @@unique([rollNo, class, createdById])
  @@index([rollNo])
  @@index([class])
  @@index([name])
}

model Event {
  id                 String              @id @default(cuid())
  name               String              @default("New Event")
  description        String              @default("")
  deadline           DateTime            @default(now())
  cost               Float               @default(0)
  paymentOptions     String              @default("[\"Razorpay\"]")
  qrCodeUrl          String?
  category           String              @default("Normal")
  status             String              @default("PUBLISHED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  slug               String?             @unique
  createdBy          User?               @relation("CreatedEvents", fields: [createdById], references: [id])
  expenses           Expense[]
  payments           Payment[]
  additionalRevenues AdditionalRevenue[]
  printDistributions PrintDistribution[]
  participants       Student[]           @relation("EventToStudent")

  @@index([deadline])
  @@index([category])
  @@index([createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  amount            Float
  paymentDate       DateTime @default(now())
  transactionId     String?
  status            String
  paymentMethod     String
  screenshotUrl     String?
  razorpay_order_id String?
  isManualEntry     Boolean  @default(false)
  recordedBy        String?
  manualEntryNotes  String?
  receiptNumber     String?
  studentId         String
  eventId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([eventId])
  @@index([status])
  @@index([paymentDate])
  @@index([studentId, eventId])
}

model PrintDistribution {
  id            String   @id @default(cuid())
  distributedAt DateTime @default(now())
  studentId     String
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([eventId])
}

model Expense {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  date       DateTime @default(now())
  category   String   @default("General")
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  eventId    String?
  billUrl    String?
  note       String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recorder   User?    @relation(fields: [recordedBy], references: [id])

  @@index([date])
  @@index([eventId])
}

model QrCode {
  id        String   @id @default(cuid())
  name      String
  url       String
  adminId   String?
  admin     User?    @relation("AdminQrCodes", fields: [adminId], references: [id])

  @@index([name])
  @@index([adminId])
}

model AdditionalRevenue {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  source      String   @default("Other")
  date        DateTime @default(now())
  note        String?
  eventId     String
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recorder    User?    @relation(fields: [recordedBy], references: [id])

  @@index([eventId])
}
